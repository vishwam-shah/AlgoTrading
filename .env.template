# ============================================================
# Angel One SmartAPI Credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Get from: https://smartapi.angelbroking.com → My Apps
ANGEL_API_KEY=your_smartapi_key_here

# Your Angel One client/demat ID (format: A1234567)
ANGEL_CLIENT_ID=your_client_id_here

# Your Angel One trading password
ANGEL_PASSWORD=your_password_here

# Base32 TOTP secret from Angel One 2FA setup
# (shown when you first enable TOTP in the Angel One app)
ANGEL_TOTP_SECRET=your_totp_base32_secret_here

# ============================================================
# Optional: Override default settings
# ============================================================
# PORTFOLIO_CAPITAL=500000
# MAX_POSITION_PCT=0.12
# MAX_DAILY_LOSS_PCT=0.02
