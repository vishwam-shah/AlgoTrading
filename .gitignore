# ── Generated artefacts that are too large for git ──────────────────────────
# Generated data + logs + run results regenerate locally — do not commit.
V3/01_data/features/
V3/02_models/runs/
V3/02_models/production/
V3/02_models/finbert_india/checkpoints/
V3/02_models/finbert_india/runs/
