# ── Generated artefacts that are too large for git ──────────────────────────
# Keep raw OHLCV (16 MB) + run results (~440 MB) + execution-log JSONs in the
# repo so a fresh clone on a new machine has data to drive the dashboard.
# DROP: trained model weights (3.8 GB), windowed model runs (18 GB), FinBERT
# checkpoints (46 GB), feature cache (regenerated by features.py in seconds).
V3/01_data/features/
V3/02_models/runs/
V3/02_models/production/
V3/02_models/finbert_india/checkpoints/
V3/02_models/finbert_india/runs/
V3/02_models/finbert_india/*.safetensors
V3/02_models/finbert_india/*.bin
V3/02_models/finbert_india/*.pt
V3/01_data/_earnings_cache/
V3/01_data/_news_cache/
V3/07_pipeline/logs/
V3/05_live_trading/logs/
V3/05_live_trading/execution_logs/archive/
V3/05_live_trading/paper_trading_logs/archive/

# ── Default-ignore generated binaries, then unignore specific committable dirs
*.parquet
*.pkl
*.joblib
*.h5
*.keras
*.npy
*.npz
*.arrow
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# Unignore raw OHLCV cache (small + needed by predict_one.py / pipeline)
!V3/01_data/raw/
!V3/01_data/raw/*.parquet

# Unignore canonical run artefacts (the dashboard reads these)
!V3/06_results/
!V3/06_results/runs/
!V3/06_results/runs/**

# Unignore execution-log JSONs (used by the ledger rebuild)
!V3/05_live_trading/execution_logs/
!V3/05_live_trading/execution_logs/*.json
!V3/05_live_trading/orders/
!V3/05_live_trading/orders/*.json
!V3/05_live_trading/ledger/
!V3/05_live_trading/ledger/*.json

# Unignore the canonical Angel symbol-token map cache (small JSON)
!V3/01_data/raw/angel_token_map_NSE.json

# ── Source CSVs / configs ────────────────────────────────────────────────────
data/raw/
data/processed/
data/features/

# ── ngrok / archive ──────────────────────────────────────────────────────────
ngrok
ngrok.zip
*.zip
_archive/

# ── Logs (text) ──────────────────────────────────────────────────────────────
logs/
*.log

# ── Images / plots — global ignore but explicit allow for source assets ─────
*.png
*.jpg
*.jpeg
*.gif
*.pdf

!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.svg
!frontend/public/**/*.ico
# Allow run plots that the dashboard serves
!V3/06_results/runs/**/*.png

