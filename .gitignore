# ── Default-ignore generated binaries, then unignore specific committable dirs
*.parquet
*.pkl
*.joblib
*.h5
*.keras
*.npy
*.npz
*.arrow
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# Keep V3/01_data/raw/ directory tracked only for the small angel_token_map
# JSON cache (whitelisted explicitly below); .parquet OHLCV regenerates locally.
!V3/01_data/raw/

# Unignore the canonical Angel symbol-token map cache (small JSON)
!V3/01_data/raw/angel_token_map_NSE.json

