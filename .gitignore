# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Node.js / Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.next/
.pnp/
.pnp.js

# ── Data files (large, regeneratable) ────────────────────────────────────────
*.parquet
*.pkl
*.joblib
*.h5
*.keras
*.npy
*.npz
*.arrow

# Keep source CSVs (stock lists, configs) but not generated ones
data/raw/
data/processed/
data/features/

# ── V3 generated data — never commit ─────────────────────────────────────────
V3/01_data/raw/
V3/01_data/features/
V3/02_models/runs/
V3/02_models/production/
V3/07_pipeline/logs/
V3/05_live_trading/execution_logs/

# ── V3 run results (plots + per-stock CSVs) — all runs ignored ───────────────
V3/06_results/runs/

# ── ML model files ────────────────────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.bin
*.safetensors
models/**/*.h5
models/**/*.pkl
models/**/*.json
models/**/*.pt

# ── FinBERT / HuggingFace checkpoints (very large) ───────────────────────────
V3/02_models/finbert_india/checkpoints/
V3/02_models/finbert_india/runs/

# ── Earnings / news cache ─────────────────────────────────────────────────────
V3/01_data/_earnings_cache/
V3/01_data/_news_cache/

# ── FinBERT base model weights ────────────────────────────────────────────────
V3/02_models/finbert_india/*.safetensors
V3/02_models/finbert_india/*.bin
V3/02_models/finbert_india/*.pt

# ── ngrok binary ─────────────────────────────────────────────────────────────
ngrok
ngrok.zip
*.zip

# ── Archive / old model outputs ───────────────────────────────────────────────
_archive/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Images / plots (generated, not source assets) ────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.pdf

# Allow frontend public assets
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!frontend/public/**/*.svg
!frontend/public/**/*.ico

# ── Large JSON outputs (keep small config JSONs) ──────────────────────────────
# Ignore per-stock/per-run JSON blobs but keep small configs
V3/06_results/**/*.json
V3/05_live_trading/**/*.json

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
._*
.Spotlight-V100
.Trashes

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.secret
*.pem
*.p12
config_secret.py

# ── Temporary / cache ─────────────────────────────────────────────────────────
*.tmp
*.bak
*.cache
.cache/
*.lock
!package-lock.json
!yarn.lock

# ── Frontend build artifacts ──────────────────────────────────────────────────
